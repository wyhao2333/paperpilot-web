# Local defaults. Set the public HTTPS origin and secure cookies before Tunnel deployment.
APP_HOST=127.0.0.1
APP_PORT=8765
APP_ORIGIN=http://localhost:8765
APP_SECURE_COOKIES=auto
# Native localhost only: enter administrator workspace without a login form.
# Docker Compose disables this; provision the Docker admin with the offline CLI.
LOCAL_ADMIN_AUTOLOGIN=true
APP_DATA_DIR=data
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=200
MAX_USER_STORAGE_MB=1024
# Optional application quota, separate from provider billing. 0 = unlimited.
DAILY_TEXT_LIMIT=0
# Only enable for a trusted local model/translation server; keep false for shared hosting.
ALLOW_LOCAL_API=false
# Optional outbound proxy for API calls. PDF files stay on this server.
# HTTPS_PROXY=http://127.0.0.1:7890
