{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "types": ["vite/client"], "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
